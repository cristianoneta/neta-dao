# Used by the snapshot-only edge and imported by the combined API/data edge.
# Only the allowlisted publisher output belongs in the read-only snapshots mount.
data.cosmoot.com {
    root * /snapshots/current
    @snapshots path /data/*
    handle @snapshots {
        header Cache-Control "public, max-age=60, s-maxage=60"
        header X-Content-Type-Options nosniff
        file_server
    }
    respond 404
}
