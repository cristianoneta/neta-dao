{
  "name": "cosmoot-workspace",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "node scripts/format-sources.mjs --write",
    "format:check": "node scripts/format-sources.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.typecheck.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
